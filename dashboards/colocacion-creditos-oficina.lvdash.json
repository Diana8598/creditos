{
  "datasets": [
    {
      "name": "43c41558",
      "displayName": "colocacion_mensual",
      "config": {
        "version": "1.1",
        "source": "workspace.credito_gold.colocacion_mensual",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "oficina",
            "expr": "concat(CAST(source.codigo_oficina AS STRING), ' - ', source.municipio)",
            "displayName": "Oficina"
          }
        ],
        "measures": [
          {
            "name": "monto_total",
            "expr": "SUM(source.monto_colocado)",
            "displayName": "Monto colocado",
            "format": {
              "type": "currency",
              "currencyCode": "COP",
              "abbreviation": "compact"
            }
          },
          {
            "name": "creditos_totales",
            "expr": "SUM(source.creditos_colocados)",
            "displayName": "Créditos colocados"
          },
          {
            "name": "mora_total",
            "expr": "SUM(source.creditos_en_mora)",
            "displayName": "Créditos en mora"
          },
          {
            "name": "ticket_promedio_medio",
            "expr": "AVG(source.ticket_promedio)",
            "displayName": "Ticket promedio",
            "format": {
              "type": "currency",
              "currencyCode": "COP",
              "abbreviation": "compact"
            }
          },
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "da9175a1",
      "displayName": "creditos_raw",
      "config": {
        "version": "1.1",
