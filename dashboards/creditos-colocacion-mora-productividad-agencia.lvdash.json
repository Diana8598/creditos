{
  "datasets": [
    {
      "name": "colocacion_mensual",
      "displayName": "Colocación Mensual (Gold)",
      "config": {
        "source": "workspace.credito_gold.colocacion_mensual",
        "measures": [
          {
            "name": "monto_colocado_MM",
            "expr": "SUM(monto_colocado) / 1000000",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "creditos_colocados_total",
            "expr": "SUM(creditos_colocados)"
          },
          {
            "name": "creditos_mora_total",
            "expr": "SUM(creditos_en_mora)"
          }
        ],
        "version": "1.1",
        "comment": "Colocación mensual por agencia, junio a octubre 2026 (capa gold)",
        "dimensions": [
          {
            "expr": "mes",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          },
          {
            "expr": "codigo_oficina"
          },
          {
            "expr": "municipio"
          }
        ]
      }
    },
    {
      "name": "creditos_clientes",
      "displayName": "Créditos y Clientes (Silver)",
      "config": {
        "source": "workspace.credito_silver.creditos_clientes",
        "measures": [
          {
            "name": "monto_desembolsado_MM",
            "expr": "SUM(monto_desembolsado) / 1000000",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "saldo_capital_MM",
            "expr": "SUM(saldo_capital) / 1000000"
          },
          {
            "name": "num_creditos",
            "expr": "COUNT(1)"
          },
          {
            "name": "score_promedio",
            "expr": "AVG(score_crediticio)"
          },
          {
            "name": "edad_promedio",
            "expr": "AVG(edad)"
          },
          {
            "name": "pct_creditos_mora",
            "expr": "SUM(flag_en_mora) / COUNT(1)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Detalle por crédito y cliente (capa silver)",
        "dimensions": [
          {
            "expr": "tipo_credito"
          },
          {
            "expr": "codigo_oficina"
          },
          {
            "expr": "municipio"
          },
          {
            "expr": "rango_mora"
          },
          {
            "expr": "genero"
          }
        ]
      }
    },
    {
      "name": "metricas_agencia",
      "displayName": "Métricas por Agencia (Gold)",
      "config": {
        "source": "workspace.credito_gold.metricas_agencia",
        "measures": [
          {
            "name": "monto_colocado_MM",
            "expr": "SUM(monto_colocado) / 1000000",
            "displayName": "Monto colocado ($MM)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "creditos_colocados_total",
            "expr": "SUM(creditos_colocados)"
          },
          {
            "name": "creditos_mora_total",
            "expr": "SUM(creditos_en_mora)"
          },
          {
            "name": "saldo_mora_MM",
            "expr": "SUM(saldo_capital_en_mora) / 1000000",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "pct_creditos_mora",
            "expr": "SUM(creditos_en_mora) / NULLIF(SUM(creditos_colocados), 0)",
            "displayName": "% créditos en mora",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "imor",
            "expr": "SUM(saldo_capital_en_mora) / NULLIF(SUM(saldo_capital_total), 0)",
            "displayName": "IMOR",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "score_prom",
            "expr": "AVG(score_promedio)",
            "displayName": "Score promedio"
          },
          {
            "name": "dias_mora_prom",
            "expr": "AVG(dias_mora_promedio)"
          },
          {
            "name": "ticket_promedio_MM",
            "expr": "SUM(monto_colocado) / NULLIF(SUM(creditos_colocados), 0) / 1000000",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "coloc_asesor_MM",
            "expr": "(SUM(monto_colocado) / 1000000) / NULLIF(SUM(numero_asesores), 0)",
            "displayName": "Colocación por asesor ($MM)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "clientes_asesor",
            "expr": "SUM(clientes_activos) / NULLIF(SUM(numero_asesores), 0)",
            "displayName": "Clientes por asesor",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "cumplimiento_meta",
            "expr": "SUM(desembolso_acumulado) / NULLIF(SUM(meta_historica), 0)",
            "displayName": "Cumplimiento de meta",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "asesores_total",
            "expr": "SUM(numero_asesores)"
          }
        ],
        "version": "1.1",
        "comment": "Métricas de colocación, mora y productividad por agencia comercial (capa gold)",
        "dimensions": [
          {
            "expr": "codigo_oficina"
          },
          {
            "expr": "zona"
          },
          {
            "expr": "municipio"
          }
        ]
      }
    }
  ],
